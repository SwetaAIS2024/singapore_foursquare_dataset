# Environment Configuration Template
# Copy this file to .env and customize as needed

# ====================================
# Python Environment
# ====================================
PYTHON_ENV=development

# ====================================
# Custom Data Paths (Optional)
# By default, paths are defined in config/paths.py
# Only set these if you need to override defaults
# ====================================
# DATA_RAW_PATH=./data/raw
# DATA_INTERIM_PATH=./data/interim
# DATA_PROCESSED_PATH=./data/processed
# DATA_SYNTHETIC_PATH=./data/synthetic

# ====================================
# API Keys (Optional - for future features)
# ====================================
# GEOPY_API_KEY=your_nominatim_api_key_here
# DATABRICKS_TOKEN=your_databricks_token_here
# OPENAI_API_KEY=your_openai_key_here

# ====================================
# Processing Parameters (Optional)
# Override default parameters from config/parameters.json
# ====================================
# MIN_INTERACTIONS=5
# BATCH_SIZE=100
# N_USERS=1000
# N_POIS=100

# ====================================
# Logging Configuration
# ====================================
# LOG_LEVEL=INFO
# LOG_FILE=./logs/pipeline.log

# ====================================
# Database Configuration (Optional)
# ====================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=singapore_fsq
# DB_USER=your_username
# DB_PASSWORD=your_password
